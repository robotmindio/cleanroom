<?xml version="1.0"?>
<!-- ROS description wrapper for the physical LeKiwi CAD model. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lekiwi">
  <xacro:arg name="sim" default="false"/>
  <!-- The one tracked source for physical sensor calibration.  Every consumer
       expands this Xacro (robot_state_publisher, MoveIt, and RViz), so changing
       a measured value here cannot make their models disagree. -->
  <xacro:property name="astra_mount_xyz" value="0 0 0"/>
  <xacro:property name="astra_mount_rpy" value="0 0 0"/>
  <xacro:property name="wrist_camera_xyz" value="0 0 0"/>
  <xacro:property name="wrist_camera_rpy" value="0 0 0"/>
  <xacro:property name="lidar_offset_xyz" value="0 0 0"/>
  <xacro:property name="lidar_offset_yaw" value="0"/>
  <!-- The simulator now drives the same six bounded joints as the hardware.
       Keep the joint type identical in both descriptions so a plan validated
       in Gazebo has the same kinematic constraints on the physical robot. -->
  <xacro:property name="arm_joint" value="revolute"/>
  <!-- The physical wrist cable and servo have a bounded safe travel envelope.
       Declaring it continuous makes MoveIt discard the configured bounds. -->
  <xacro:property name="roll_joint" value="revolute"/>
  <!-- Complete model vendored from robotmindio/LeKiwi at 597e2da; see urdf/README.md. -->
  <xacro:include filename="lekiwi_cad.urdf"/>

  <!-- CAD's root is the lower base plate. Its +Y is the physical forward
       direction, so yaw -90 degrees aligns it with REP-103 +X forward. -->
  <link name="base_footprint"/>
  <link name="base_link">
    <!-- Conservative planning proxy; CAD meshes are visual-only. -->
    <collision><geometry><cylinder radius="0.145" length="0.090"/></geometry></collision>
  </link>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.093" rpy="0 0 0"/>
  </joint>
  <joint name="base_link_to_cad" type="fixed">
    <parent link="base_link"/><child link="base_plate_layer1-v5"/>
    <origin xyz="0 0 0" rpy="0 0 -1.57079632679"/>
  </joint>

  <!-- Named ROS camera frames; CAD links locate the physical mounts. -->
  <link name="front_camera_link"/>
  <joint name="front_camera_mount" type="fixed">
    <parent link="Camera-Model-v3"/><child link="front_camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="front_camera_optical_frame"/>
  <joint name="front_camera_optical" type="fixed">
    <parent link="front_camera_link"/><child link="front_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <!-- Astra Pro is distinct from the existing front and wrist cameras. Its
       165 x 48 x 40 mm body is visual-only; mount calibration remains above. -->
  <link name="astra_camera_link">
    <visual>
      <origin xyz="-0.020 0 0" rpy="0 0 0"/>
      <geometry><box size="0.040 0.165 0.048"/></geometry>
      <material name="astra_body"><color rgba="0.08 0.18 0.25 1"/></material>
    </visual>
  </link>
  <joint name="astra_camera_mount" type="fixed">
    <parent link="Camera-Model-v3"/><child link="astra_camera_link"/>
    <origin xyz="${astra_mount_xyz}" rpy="${astra_mount_rpy}"/>
  </joint>
  <link name="astra_camera_optical_frame"/>
  <joint name="astra_camera_optical" type="fixed">
    <parent link="astra_camera_link"/><child link="astra_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="wrist_camera_link"/>
  <joint name="wrist_camera_mount" type="fixed">
    <parent link="so101_gripper_link"/><child link="wrist_camera_link"/>
    <origin xyz="${wrist_camera_xyz}" rpy="${wrist_camera_rpy}"/>
  </joint>
  <link name="wrist_camera_optical_frame"/>
  <joint name="wrist_camera_optical" type="fixed">
    <parent link="wrist_camera_link"/><child link="wrist_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- Tool frame before the independently planned gripper joint. -->
  <link name="tool0">
    <collision><geometry><sphere radius="0.025"/></geometry></collision>
  </link>
  <joint name="tool0_mount" type="fixed">
    <parent link="so101_gripper_frame_link"/><child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Low-poly self-collision proxies. These are deliberately attached to the
       CAD links, so their kinematics remain exact while planning stays
       real-time.  The dimensions below enclose the vendored mesh bounding
       vertices with a further 4 mm clearance; they are not substitute visual
       geometry.  A capsule is a cylinder along local Z with a sphere on each
       end, which covers a complete arm link instead of just its joint centre. -->
  <xacro:macro name="collision_sphere_proxy" params="name parent xyz radius">
    <link name="${name}"><collision><geometry><sphere radius="${radius}"/></geometry></collision></link>
    <joint name="${name}_mount" type="fixed">
      <parent link="${parent}"/><child link="${name}"/><origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="collision_capsule_proxy" params="name parent xyz rpy radius cylinder_length">
    <link name="${name}">
      <collision><geometry><cylinder radius="${radius}" length="${cylinder_length}"/></geometry></collision>
      <collision><origin xyz="0 0 ${cylinder_length / 2.0}"/><geometry><sphere radius="${radius}"/></geometry></collision>
      <collision><origin xyz="0 0 ${-cylinder_length / 2.0}"/><geometry><sphere radius="${radius}"/></geometry></collision>
    </link>
    <joint name="${name}_mount" type="fixed">
      <parent link="${parent}"/><child link="${name}"/><origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- Pedestal and camera are part of the manipulator's swept volume. -->
  <xacro:collision_sphere_proxy name="arm_pedestal_collision_proxy" parent="so101_base_link" xyz="0.0168 0 0.0336" radius="0.0857"/>
  <xacro:collision_sphere_proxy name="front_camera_collision_proxy" parent="Camera-Model-v3" xyz="-0.0158 0.0114 -0.0114" radius="0.0332"/>

  <!-- SO-101 aggregate links already contain their servo housings. These
       CAD-bounds-derived envelopes therefore cover each complete moving link. -->
  <xacro:collision_capsule_proxy name="shoulder_collision_proxy" parent="so101_shoulder_link" xyz="-0.0192 0.0012 -0.0091" rpy="0 0 0" radius="0.0458" cylinder_length="0.0190"/>
  <xacro:collision_capsule_proxy name="upper_arm_collision_proxy" parent="so101_upper_arm_link" xyz="-0.0591 -0.0131 0.0202" rpy="0 1.5708 0" radius="0.0460" cylinder_length="0.0502"/>
  <xacro:collision_capsule_proxy name="forearm_collision_proxy" parent="so101_lower_arm_link" xyz="-0.0666 0.0035 0.0202" rpy="0 1.5708 0" radius="0.0411" cylinder_length="0.0749"/>
  <xacro:collision_sphere_proxy name="wrist_collision_proxy" parent="so101_wrist_link" xyz="-0.0022 -0.0269 0.0222" radius="0.0569"/>
  <xacro:collision_capsule_proxy name="roll_collision_proxy" parent="so101_gripper_link" xyz="-0.0024 -0.0020 -0.0517" rpy="0 0 0" radius="0.0459" cylinder_length="0.0136"/>
  <xacro:collision_capsule_proxy name="gripper_collision_proxy" parent="so101_moving_jaw_link" xyz="-0.0012 -0.0360 0.0189" rpy="1.5708 0 0" radius="0.0305" cylinder_length="0.0310"/>

  <!-- LD06 scan plane: the RobotSkin base puts it 90 mm forward, 70 mm right,
       and 31.5 mm above base_link. The nominal frame stays on the CAD body;
       the child is the small measured correction used by the scan. -->
  <link name="laser_nominal"/>
  <joint name="laser_nominal_mount" type="fixed">
    <parent link="ld06_body"/><child link="laser_nominal"/>
    <origin xyz="0 0 0.0195" rpy="0 0 0"/>
  </joint>
  <link name="laser"/>
  <joint name="laser_calibration" type="fixed">
    <parent link="laser_nominal"/><child link="laser"/>
    <origin xyz="${lidar_offset_xyz}" rpy="0 0 ${lidar_offset_yaw}"/>
  </joint>

  <link name="lidar_collision_proxy">
    <collision><origin xyz="0 0 0.0195" rpy="0 0 0"/><geometry><cylinder radius="0.0245" length="0.039"/></geometry></collision>
  </link>
  <joint name="lidar_collision_proxy_mount" type="fixed">
    <parent link="ld06_body"/><child link="lidar_collision_proxy"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo-only contact and actuator model.  The CAD wheel meshes and their
       measured mass remain vendored and untouched.  These small invisible
       spheres supply the roller contact that the visual-only CAD lacks.  Each
       axle is radial; positive rotation therefore drives tangentially in the
       same [240, 0, 120]-90 degree convention as LeRobot's kinematics. -->
  <xacro:if value="$(arg sim)">
    <xacro:macro name="sim_omni_wheel" params="name xyz axis">
      <link name="${name}_contact">
        <inertial>
          <mass value="0.005"/>
          <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
        </inertial>
        <collision name="contact">
          <geometry><sphere radius="0.050"/></geometry>
        </collision>
      </link>
      <joint name="${name}_joint" type="continuous">
        <parent link="base_link"/><child link="${name}_contact"/>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <axis xyz="${axis}"/>
        <dynamics damping="0.02" friction="0.01"/>
        <limit effort="1.2" velocity="12.0"/>
      </joint>
      <gazebo>
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
          <joint_name>${name}_joint</joint_name>
          <!-- The model-local watchdog is the only writer to the native
               controller.  The public topic remains bridge-compatible. -->
          <topic>/sim/${name}/native_cmd_vel</topic>
          <!-- The ROS-side controller ramps every target with measured
               acceleration and jerk limits. Gazebo then constrains that wheel
               rate through contact; applying another PID here produced a
               drivetrain-dependent hidden ramp and asymmetric tracking. -->
        </plugin>
      </gazebo>
    </xacro:macro>

    <!-- Wheel centres use the 0.125 m radius assumed by the hardware firmware.
         z=-0.043 puts the 50 mm contact radius on z=0 when base_link is 93 mm
         above base_footprint. -->
    <xacro:sim_omni_wheel name="sim_base_left_wheel" xyz="0.0625 0.108253 -0.043" axis="-0.5 -0.866025 0"/>
    <xacro:sim_omni_wheel name="sim_base_back_wheel" xyz="-0.125 0 -0.043" axis="1 0 0"/>
    <xacro:sim_omni_wheel name="sim_base_right_wheel" xyz="0.0625 -0.108253 -0.043" axis="-0.5 0.866025 0"/>

    <gazebo>
      <!-- Gazebo-native fail-safe: public bridge topics are forwarded only
           while fresh. If ros_gz_bridge or either ROS adapter disappears,
           it actively zeros wheel demand and interrupts the native arm
           trajectory with a current-position hold. -->
      <plugin filename="liblekiwi_sim_native_failsafe.so" name="lekiwi_rmf::SimNativeFailsafe"/>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/sim/joint_states</topic><update_rate>50</update_rate>
        <joint_name>sim_base_left_wheel_joint</joint_name>
        <joint_name>sim_base_back_wheel_joint</joint_name>
        <joint_name>sim_base_right_wheel_joint</joint_name>
        <joint_name>arm_shoulder_pan</joint_name>
        <joint_name>arm_shoulder_lift</joint_name>
        <joint_name>arm_elbow_flex</joint_name>
        <joint_name>arm_wrist_flex</joint_name>
        <joint_name>arm_wrist_roll</joint_name>
        <joint_name>arm_gripper</joint_name>
      </plugin>
      <plugin filename="gz-sim-joint-trajectory-controller-system" name="gz::sim::systems::JointTrajectoryController">
        <topic>/sim/arm/native_joint_trajectory</topic>
        <joint_name>arm_shoulder_pan</joint_name><initial_position>0</initial_position>
        <position_p_gain>18</position_p_gain><position_i_gain>0.2</position_i_gain><position_d_gain>0.8</position_d_gain>
        <position_cmd_min>-4</position_cmd_min><position_cmd_max>4</position_cmd_max>
        <joint_name>arm_shoulder_lift</joint_name><initial_position>0</initial_position>
        <position_p_gain>70</position_p_gain><position_i_gain>0.3</position_i_gain><position_d_gain>2.0</position_d_gain>
        <position_cmd_min>-4</position_cmd_min><position_cmd_max>4</position_cmd_max>
        <joint_name>arm_elbow_flex</joint_name><initial_position>0</initial_position>
        <position_p_gain>70</position_p_gain><position_i_gain>0.3</position_i_gain><position_d_gain>2.0</position_d_gain>
        <position_cmd_min>-4</position_cmd_min><position_cmd_max>4</position_cmd_max>
        <joint_name>arm_wrist_flex</joint_name><initial_position>0</initial_position>
        <position_p_gain>12</position_p_gain><position_i_gain>0.1</position_i_gain><position_d_gain>0.4</position_d_gain>
        <position_cmd_min>-2</position_cmd_min><position_cmd_max>2</position_cmd_max>
        <joint_name>arm_wrist_roll</joint_name><initial_position>0</initial_position>
        <position_p_gain>12</position_p_gain><position_i_gain>0.1</position_i_gain><position_d_gain>0.4</position_d_gain>
        <position_cmd_min>-2</position_cmd_min><position_cmd_max>2</position_cmd_max>
        <joint_name>arm_gripper</joint_name><initial_position>0</initial_position>
        <position_p_gain>8</position_p_gain><position_i_gain>0.05</position_i_gain><position_d_gain>0.25</position_d_gain>
        <position_cmd_min>-1</position_cmd_min><position_cmd_max>1</position_cmd_max>
      </plugin>
    </gazebo>
    <gazebo reference="laser">
      <sensor name="lidar" type="gpu_lidar">
        <topic>/scan</topic><gz_frame_id>laser</gz_frame_id><update_rate>10</update_rate><always_on>true</always_on>
        <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.08</min><max>12</max><resolution>0.01</resolution></range></lidar>
      </sensor>
    </gazebo>
    <gazebo reference="front_camera_link">
      <sensor name="front_camera" type="camera">
        <topic>/camera/front</topic><gz_frame_id>front_camera_optical_frame</gz_frame_id><update_rate>20</update_rate><always_on>true</always_on>
        <camera><horizontal_fov>1.0472</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>20</far></clip><noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise></camera>
      </sensor>
      <!-- The depth stream is deliberately lower-rate and noisier than RGB.
           launch/bringup adds a seeded delay/dropout stage before exposing its
           point cloud to MoveIt's occupancy-map monitor. -->
      <sensor name="front_depth" type="depth_camera">
        <topic>/camera/depth</topic><gz_frame_id>front_camera_optical_frame</gz_frame_id><update_rate>10</update_rate><always_on>true</always_on>
        <camera><horizontal_fov>1.0472</horizontal_fov><image><width>320</width><height>240</height><format>R_FLOAT32</format></image><clip><near>0.10</near><far>3.0</far></clip><noise><type>gaussian</type><mean>0</mean><stddev>0.012</stddev></noise></camera>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
