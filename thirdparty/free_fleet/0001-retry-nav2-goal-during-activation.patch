+    def _execute_nav(self, nav_handle, action_name):
+        # bt_navigator rejects goals while its lifecycle manager is still
+        # activating it -- RMF can start commanding seconds before Nav2 finishes
+        # coming up (observed 1.6s early). A silent zenoh query (bridge not up
+        # yet) leaves no goal id either. Both recover within moments; retrying
+        # here avoids burning a fleet-level replan, which stalls on traffic
+        # planning and can leave the robot idle until it times out.
+        attempts = 5
+        for attempt in range(attempts):
+            try:
+                nav_handle.execute()
+                if nav_handle.get_goal_id() is not None:
+                    return
+            except RequestRejected:
+                pass
+            if attempt < attempts - 1:
+                self.node.get_logger().info(
+                    f'{action_name} goal not accepted yet; Nav2 may still be '
+                    f'activating -- retrying ({attempt + 1}/{attempts - 1})'
+                )
+                time.sleep(1.0)
+        raise RequestRejected
+
