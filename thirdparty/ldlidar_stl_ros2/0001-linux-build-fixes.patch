@@ -105,17 +105,20 @@ bool SerialInterfaceLinux::Close() {
 
   rx_thread_exit_flag_ = true;
 
-  if (com_handle_ != -1) {
-    close(com_handle_);
-    com_handle_ = -1;
-  }
-
+  // Stop the reader before the descriptor disappears. Closing first left the
+  // rx thread racing FD_SET()/pselect() against com_handle_ becoming -1,
+  // which glibc rejects with "bit out of range 0 - FD_SETSIZE" and SIGABRT.
   if ((rx_thread_ != nullptr) && rx_thread_->joinable()) {
     rx_thread_->join();
     delete rx_thread_;
     rx_thread_ = nullptr;
   }
 
+  if (com_handle_ != -1) {
+    close(com_handle_);
+    com_handle_ = -1;
+  }
+
   is_cmd_opened_ = false;
 
   return true;
