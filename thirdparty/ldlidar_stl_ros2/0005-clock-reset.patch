diff --git a/test/clock_jump.cpp b/test/clock_jump.cpp
new file mode 100644
--- /dev/null
+++ b/test/clock_jump.cpp
@@ -0,0 +1,40 @@
+#include <cstdint>
+#include <iostream>
+#include "lipkg.h"
+
+namespace ldlidar { uint8_t CalCRC8(const uint8_t *, uint16_t); }
+
+int main() {
+  ldlidar::LiPkg parser;
+  parser.SetProductType(ldlidar::LDType::LD_06);
+  parser.EnableFilter(false);
+  uint64_t clock = 1793011200000000000ULL;
+  parser.RegisterTimestampGetFunctional([&clock]() { return clock; });
+  int before = 0, after = 0;
+  for (int index = 0; index < 400; ++index) {
+    clock += 3000000;
+    if (index == 100) clock -= 500000000;
+    if (index == 200) clock -= 3000000;
+    ldlidar::LiDARFrameTypeDef packet{};
+    packet.header = ldlidar::PKG_HEADER;
+    packet.ver_len = ldlidar::PKG_VER_LEN;
+    packet.speed = 3600;
+    packet.start_angle = (index % 36) * 1000;
+    packet.end_angle = packet.start_angle + 990;
+    for (auto &point : packet.point) { point.distance = 1000; point.intensity = 100; }
+    packet.crc8 = ldlidar::CalCRC8(reinterpret_cast<const uint8_t *>(&packet), sizeof(packet) - 1);
+    parser.CommReadCallback(reinterpret_cast<const char *>(&packet), sizeof(packet));
+    ldlidar::Points2D scan;
+    if (!parser.GetLaserScanData(scan)) continue;
+    if (index < 100) ++before; else ++after;
+    for (const auto &point : scan) {
+      if (point.stamp > clock || clock - point.stamp > 200000000) {
+        std::cerr << "invalid acquisition timestamp after clock adjustment\n";
+        return 1;
+      }
+    }
+  }
+  if (!before || !after) return 1;
+  std::cout << "valid scans before and after backward and repeated clock values\n";
+  return 0;
+}
