# LD06 publisher on the device machine.  It deliberately publishes privately;
# the compute-side launch owns the sole canonical /scan publisher.
[Unit]
Description=LeKiwi LD06 lidar publisher
Documentation=file://@PROJECT_ROOT@/HARDWARE.md
After=systemd-udevd.service
# The launcher waits for a missing serial device, so keep it retrying through
# intermittent USB resets instead of exhausting systemd's restart budget.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
Environment=HOME=@SERVICE_HOME@
Environment=LEKIWI_WS=@WORKSPACE@
WorkingDirectory=@PROJECT_ROOT@
ExecStartPre=-/usr/bin/udevadm settle --timeout=15
ExecStart=@PROJECT_ROOT@/scripts/ros-lidar.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077
# ros2 launch can exit successfully after its lidar child loses USB; restart
# on either outcome and let ros-lidar.sh wait for the stable by-id device.
Restart=always
RestartSec=10s
TimeoutStopSec=20s
KillMode=control-group

[Install]
WantedBy=multi-user.target
