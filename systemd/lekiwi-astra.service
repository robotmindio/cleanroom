# Astra RGB-D publisher for the device that owns the camera's USB connection.
[Unit]
Description=LeKiwi Astra Pro RGB-D publisher
Documentation=file://@PROJECT_ROOT@/README.md
After=systemd-udevd.service
# A flaky USB hub can reset an RGB-D camera more than eight times in ten
# minutes. Keep retrying with RestartSec below; an unavailable sensor must
# not need a human to restart its independent service.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
Environment=HOME=@SERVICE_HOME@
Environment=LEKIWI_WS=@WORKSPACE@
WorkingDirectory=@PROJECT_ROOT@
ExecStartPre=-/usr/bin/udevadm settle --timeout=15
ExecStart=@PROJECT_ROOT@/scripts/ros-astra.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077
# ros2 launch exits successfully when its Astra child dies after a USB reset.
# Always restart so a re-enumerated RGB-D device recovers without intervention.
Restart=always
RestartSec=10s
TimeoutStopSec=20s
KillMode=control-group

[Install]
WantedBy=multi-user.target
