[Unit]
Description=Restrict LeKiwi motor ports to loopback and Tailscale
After=nftables.service tailscaled.service
Before=lekiwi-host.service

[Service]
User=root
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/lekiwi/motor-network.nft
ExecReload=/usr/sbin/nft -f /etc/lekiwi/motor-network.nft
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_NETLINK AF_UNIX
# No stop action: stopping this unit must not expose motors or cut their torque.

[Install]
WantedBy=multi-user.target
