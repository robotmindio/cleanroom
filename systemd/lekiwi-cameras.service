# Camera publisher as a boot service: the ROS half of the device side. This
# unit belongs on whatever machine the USB cameras are plugged into, next to
# lekiwi-host.service (which owns the motors and deliberately never opens the
# cameras -- one reader per device, and a stalled camera must not be able to
# take the motor bus down with it). Install with
# scripts/install-device-services.sh; do not copy this file by hand.
#
# Frames are published compressed under /pi/camera/...; when the ROS stack
# runs on another machine, its bringup relays them into the canonical topics.
[Unit]
Description=LeKiwi camera publisher (v4l2_camera on the device machine)
Documentation=file://@PROJECT_ROOT@/README.md
# The /dev/v4l/by-id globs only resolve after udev has settled.
After=systemd-udevd.service
# The V4L2 supervisors wait safely for re-enumeration; do not turn repeated
# USB resets into a permanently failed service.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
Environment=HOME=@SERVICE_HOME@
Environment=LEKIWI_WS=@WORKSPACE@
Environment=LEKIWI_LEROBOT_VENV=@LEROBOT_VENV@
WorkingDirectory=@PROJECT_ROOT@
ExecStartPre=-/usr/bin/udevadm settle --timeout=15
ExecStart=@PROJECT_ROOT@/scripts/ros-cameras.sh
# Camera calibration and ROS logs live under the service HOME, and v4l2 device
# names are dynamic, so do not use ProtectHome or private device namespaces.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077
# A USB reset can make ros2 launch exit cleanly even though a camera child died.
Restart=always
RestartSec=10s
TimeoutStopSec=20s
KillMode=control-group

[Install]
WantedBy=multi-user.target
