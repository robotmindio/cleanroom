# The ROS bringup as a boot service: the compute side of the split. This unit
# belongs wherever the heavy software should run -- the robot's own computer
# or a separate one. Install with scripts/install-compute-services.sh, which
# fills in the @PLACEHOLDER@s, enables the unit, and adapts it to the
# topology; do not copy this file by hand.
#
# Two topologies, decided by that installer:
#
#   devices on this machine too (default): the installer adds a drop-in that
#     pulls in lekiwi-host.service and orders the stack after it, so the stack
#     starts only once :5555 answers -- the wait up.sh performs by hand. This
#     keeps both halves moving together like one ros-stop.sh invocation.
#     When a lekiwi-cameras.service is installed here as well, the installer
#     points the stack at it over loopback: v4l2 allows one reader per
#     camera, and the service already holds the devices.
#
#   devices elsewhere (--remote <addr>): the base unit has no local host
#     dependency, and
#     LEKIWI_STACK_ARGS carries camera_source:=remote remote_ip:=<addr>. The
#     driver then republishes the host's front JPEG as if it were local.
#
# Either way the stack may come up before the other half of the robot does.
# RestartSec paces the retries and LogRateLimit* bounds journald, so a missing
# device neither floods the log nor exhausts a restart budget.
[Unit]
Description=LeKiwi ROS 2 stack (bringup.launch.py)
Documentation=file://@PROJECT_ROOT@/README.md
After=network-online.target
Wants=network-online.target
# The self-heal watcher deliberately SIGKILLs the stack on every IPv4 change,
# and a Wi-Fi switch or DHCP renewal storm can repeat that; RestartSec paces it.
# A start limit would leave the robot without its stack until a human intervenes.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
Environment=HOME=@SERVICE_HOME@
Environment=LEKIWI_WS=@WORKSPACE@
WorkingDirectory=@PROJECT_ROOT@
# Launch arguments chosen by the installer for this topology, e.g.
# camera_source:=remote remote_ip:=... . /etc/default/lekiwi-stack is rewritten
# on every installer run; extra arguments (slam_mode:=localization) belong in a
# drop-in that repeats ExecStart= with them appended.
Environment=LEKIWI_STACK_ARGS=
EnvironmentFile=-/etc/default/lekiwi-stack
ExecStart=@PROJECT_ROOT@/scripts/ros-start.sh $LEKIWI_STACK_ARGS
# DDS transport failures must not exhaust disk through journald/rsyslog before
# the service restart budget can contain a broken network path.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
# The ROS graph and RTAB-Map database write beneath the service HOME. Keep
# that path writable; device isolation is not safe because a local deployment
# can launch camera nodes directly.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077
Restart=on-failure
RestartSec=15s
# Nav2's lifecycle teardown alone takes ~15 s (see scripts/ros-stop.sh).
TimeoutStopSec=45s
KillMode=control-group

[Install]
WantedBy=multi-user.target
