<?xml version="1.0"?>
<sdf version="1.10">
  <world name="cleanroom">
    <!-- A 2 ms integration step resolves the 50 mm wheels and the arm's
         position loops without granting the model instantaneous motion. -->
    <physics name="lekiwi_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- GPU lidar needs Ogre2. It requires an OpenGL 3.3-capable driver. The
         Raspberry Pi V3D driver exposes only OpenGL 3.1, so run simulation on
         a workstation/server with a supported GPU and leave this configuration
         free of host-specific environment overrides. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.9 0.9 0.9 1</background></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.4 0.2 -1</direction></light>
    <model name="floor"><static>true</static><pose>0 0 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>10 7 0.1</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="visual"><geometry><box><size>10 7 0.1</size></box></geometry><material><diffuse>0.72 0.76 0.78 1</diffuse></material></visual></link></model>

    <model name="walls"><static>true</static><link name="link">
      <collision name="north"><pose>0 3.5 1 0 0 0</pose><geometry><box><size>10 0.1 2</size></box></geometry></collision>
      <collision name="south"><pose>0 -3.5 1 0 0 0</pose><geometry><box><size>10 0.1 2</size></box></geometry></collision>
      <collision name="east"><pose>5 0 1 0 0 0</pose><geometry><box><size>0.1 7 2</size></box></geometry></collision>
      <collision name="west"><pose>-5 0 1 0 0 0</pose><geometry><box><size>0.1 7 2</size></box></geometry></collision>
      <collision name="divider"><pose>0 1.25 1 0 0 0</pose><geometry><box><size>0.1 4.5 2</size></box></geometry></collision>
      <!-- SDF requires collision and visual names to be unique within a link. -->
      <visual name="visual_north"><pose>0 3.5 1 0 0 0</pose><geometry><box><size>10 0.1 2</size></box></geometry></visual>
      <visual name="visual_south"><pose>0 -3.5 1 0 0 0</pose><geometry><box><size>10 0.1 2</size></box></geometry></visual>
      <visual name="visual_east"><pose>5 0 1 0 0 0</pose><geometry><box><size>0.1 7 2</size></box></geometry></visual>
      <visual name="visual_west"><pose>-5 0 1 0 0 0</pose><geometry><box><size>0.1 7 2</size></box></geometry></visual>
      <visual name="visual_divider"><pose>0 1.25 1 0 0 0</pose><geometry><box><size>0.1 4.5 2</size></box></geometry></visual>
    </link></model>

    <model name="workbench"><static>true</static><pose>3 2.5 0.45 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2.5 0.7 0.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.5 0.7 0.9</size></box></geometry><material><diffuse>0.18 0.35 0.52 1</diffuse></material></visual></link></model>
    <!-- Deliberate perception/safety fixtures for headless scan and navigation
         regression tests.  Their names are stable test contracts, and their
         positions leave the initial robot pose and checked-in graph clear. -->
    <model name="test_low_curb"><static>true</static><pose>-2.8 0.2 0.06 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 0.10 0.12</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 0.10 0.12</size></box></geometry><material><diffuse>0.9 0.25 0.1 1</diffuse></material></visual></link></model>
    <model name="test_side_post"><static>true</static><pose>-1.4 -0.3 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.06</radius><length>1.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.06</radius><length>1.0</length></cylinder></geometry><material><diffuse>0.95 0.75 0.05 1</diffuse></material></visual></link></model>
    <model name="test_rear_block"><static>true</static><pose>-3.6 -1.25 0.2 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.35 0.35 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.35 0.35 0.4</size></box></geometry><material><diffuse>0.4 0.1 0.8 1</diffuse></material></visual></link></model>
    <model name="test_overhang"><static>true</static><pose>1.8 -1.6 0.78 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.0 0.4 0.16</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 0.4 0.16</size></box></geometry><material><diffuse>0.12 0.55 0.38 1</diffuse></material></visual></link></model>
  </world>
</sdf>
