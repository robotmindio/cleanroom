<?xml version="1.0" encoding="UTF-8" ?>
<!-- Cyclone DDS allows 10 participants per domain per host by default
     (MaxAutoParticipantIndex=9). One bringup starts ~19 nodes, and every node
     past the tenth aborts with "Failed to find a free participant index". -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <!-- Bind DDS to loopback. Device sensors cross machines through the
           mutual-TLS zenoh bridge, not DDS network discovery. -->
      <Interfaces><NetworkInterface name="lo"/></Interfaces>
      <!-- Keep discovery multicast on this host only. -->
      <MulticastTimeToLive>0</MulticastTimeToLive>
      <!-- Everything DDS carries stays on this host, so datagrams can use the
           loopback MTU. The Astra driver publishes 4.9 MB clouds at 30 Hz to
           its filter; with 1,200 B fragments that is about 4,100 datagrams per
           sample, which capped delivery near 20 Hz at twice the CPU. -->
      <MaxMessageSize>65500B</MaxMessageSize>
      <FragmentSize>65000B</FragmentSize>
    </General>
    <Discovery>
      <!-- "none" drops the participant index entirely: participants take ephemeral
           ports and find each other over multicast SPDP. Raising the index limit
           instead makes discovery quadratic; every participant probes every
           allowed index of every peer, and `ros2 topic list` stops answering. -->
      <ParticipantIndex>none</ParticipantIndex>
    </Discovery>
    <Internal>
      <!-- Keep bursts of fragmented depth/cloud samples out of the kernel's
           small default queues. "default" keeps startup compatible with
           systems whose socket-buffer limit is lower than 8 MiB. -->
      <SocketReceiveBufferSize min="default" max="8MiB"/>
      <SocketSendBufferSize min="default" max="8MiB"/>
    </Internal>
  </Domain>
</CycloneDDS>
