// Device-side half of the sensor bridge (lekiwi-zenoh.service).
//
// DDS stays on each machine (cyclonedds.xml: MulticastTimeToLive 0). This
// bridge carries the device's sensor topics to the compute machine over one
// TCP link, so no router has to pass DDS multicast discovery. It only exports:
// nothing on the network can publish into the device's DDS through it.
//
// The link is mutual TLS: only a peer holding a certificate signed by the
// private CA in /etc/lekiwi/zenoh-tls can connect, and traffic is encrypted.
// scripts/setup-zenoh-tls.sh creates and installs those files; without them
// the bridge refuses to start rather than fall back to plaintext.
{
  plugins: {
    ros2dds: {
      allow: {
        publishers: [
          "^/pi/lidar/scan$",
          "^/pi/camera/(front|wrist)/(image_raw/compressed|camera_info)$",
          "^/camera/depth/points$",
          "^/camera/astra/color/image_raw/compressed$",
          "^/camera/astra/color/camera_info$",
        ],
        subscribers: [],
        service_servers: [],
        service_clients: [],
        action_servers: [],
        action_clients: [],
      },
      // The raw Astra frame stays local. The device launch compresses its optional
      // preview before this bridge. Downsample small preview messages here; large
      // point clouds are compacted on the Pi before they reach Zenoh.
      pub_max_frequencies: [
        "^/pi/camera/front/image_raw/compressed$=3",
        "^/pi/camera/wrist/image_raw/compressed$=2",
        "^/camera/astra/color/image_raw/compressed$=0.25",
      ],
      // This is a sensor-only bridge. Congestion must drop an old sample rather
      // than block a reliable DDS writer and make every later scan stale.
      reliable_routes_blocking: false,
      // Zenoh priorities: 1 is highest, 5 the default, 7 the lowest. Send each
      // small scan immediately; depth follows it and optional images go last.
      pub_priorities: [
        "^/pi/lidar/scan$=1:express",
        "^/camera/depth/points$=2",
        "^/pi/camera/(front|wrist)/image_raw/compressed$=7",
        "^/camera/astra/color/image_raw/compressed$=7",
      ],
    },
  },
  mode: "peer",
  listen: { endpoints: ["tls/0.0.0.0:7447"] },
  transport: {
    link: {
      tls: {
        root_ca_certificate: "/etc/lekiwi/zenoh-tls/ca.crt",
        listen_private_key: "/etc/lekiwi/zenoh-tls/device.key",
        listen_certificate: "/etc/lekiwi/zenoh-tls/device.crt",
        enable_mtls: true,
      },
    },
  },
  scouting: { multicast: { enabled: false }, gossip: { enabled: false } },
}
