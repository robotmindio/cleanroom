// Device-side half of the sensor bridge (lekiwi-zenoh.service).
//
// DDS stays on each machine (cyclonedds.xml: MulticastTimeToLive 0). This
// bridge carries the device's sensor topics to the compute machine over one
// TCP link, so no router has to pass DDS multicast discovery. It only exports:
// nothing on the network can publish into the device's DDS through it.
//
// The link is mutual TLS: only a peer holding a certificate signed by the
// private CA in /etc/lekiwi/zenoh-tls can connect, and traffic is encrypted.
// scripts/setup-zenoh-tls.sh creates and installs those files; without them
// the bridge refuses to start rather than fall back to plaintext.
{
  plugins: {
    ros2dds: {
      allow: {
        publishers: [
          "^/pi/lidar/scan$",
          "^/pi/camera/.*",
          "^/camera/depth/points$",
          "^/camera/astra/color/(image_raw|camera_info)$",
        ],
        subscribers: [],
        service_servers: [],
        service_clients: [],
        action_servers: [],
        action_clients: [],
      },
      // Raw Astra color is only an RViz preview; cap it so it never crowds
      // the lidar and depth cloud out of the Wi-Fi link.
      pub_max_frequencies: ["^/camera/astra/color/image_raw$=2"],
    },
  },
  mode: "peer",
  listen: { endpoints: ["tls/0.0.0.0:7447"] },
  transport: {
    link: {
      tls: {
        root_ca_certificate: "/etc/lekiwi/zenoh-tls/ca.crt",
        listen_private_key: "/etc/lekiwi/zenoh-tls/device.key",
        listen_certificate: "/etc/lekiwi/zenoh-tls/device.crt",
        enable_mtls: true,
      },
    },
  },
  scouting: { multicast: { enabled: false }, gossip: { enabled: false } },
}
