<?xml version="1.0" encoding="UTF-8"?>
<!-- Semantic model for the CAD-backed physical description. -->
<robot name="lekiwi">
  <!-- tool0 is attached before arm_gripper, so Cartesian arm planning does not
       move the claw. The gripper remains an independently controlled group. -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>
  <group name="gripper">
    <joint name="arm_gripper"/>
  </group>
  <group_state name="home" group="arm">
    <joint name="arm_shoulder_pan" value="0"/>
    <joint name="arm_shoulder_lift" value="0"/>
    <joint name="arm_elbow_flex" value="0"/>
    <joint name="arm_wrist_flex" value="0"/>
    <joint name="arm_wrist_roll" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="arm_gripper" value="1.74533"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="arm_gripper" value="-0.174533"/>
  </group_state>

  <!-- These pairs are bolted or directly adjacent and cannot be external
       collisions. The SO-101 model groups physical parts by moving link. -->
  <disable_collisions link1="base_plate_layer1-v5" link2="drive_motor_mount-v11-2" reason="Adjacent"/>
  <disable_collisions link1="base_plate_layer1-v5" link2="drive_motor_mount-v11-1" reason="Adjacent"/>
  <disable_collisions link1="base_plate_layer1-v5" link2="drive_motor_mount-v11" reason="Adjacent"/>
  <disable_collisions link1="base_plate_layer1-v5" link2="Camera-Mount-v8" reason="Adjacent"/>
  <disable_collisions link1="Camera-Mount-v8" link2="Camera-Model-v3" reason="Adjacent"/>
  <disable_collisions link1="Camera-Model-v3" link2="front_camera_link" reason="Adjacent"/>
  <disable_collisions link1="front_camera_link" link2="front_camera_optical_frame" reason="Adjacent"/>
  <disable_collisions link1="base_plate_layer2-v3" link2="so101_base_link" reason="Adjacent"/>
  <disable_collisions link1="so101_base_link" link2="so101_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="so101_shoulder_link" link2="so101_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="so101_upper_arm_link" link2="so101_lower_arm_link" reason="Adjacent"/>
  <disable_collisions link1="so101_lower_arm_link" link2="so101_wrist_link" reason="Adjacent"/>
  <disable_collisions link1="so101_wrist_link" link2="so101_gripper_link" reason="Adjacent"/>
  <disable_collisions link1="so101_gripper_link" link2="so101_moving_jaw_link" reason="Adjacent"/>
  <disable_collisions link1="so101_gripper_link" link2="so101_gripper_frame_link" reason="Adjacent"/>
  <disable_collisions link1="so101_gripper_link" link2="wrist_camera_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_camera_link" link2="wrist_camera_optical_frame" reason="Adjacent"/>
  <disable_collisions link1="so101_gripper_frame_link" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="base_plate_layer1-v5" reason="Adjacent"/>
  <disable_collisions link1="base_plate_layer2-v3" link2="robotskin_lidar_mount" reason="Adjacent"/>
  <disable_collisions link1="robotskin_lidar_mount" link2="ld06_body" reason="Adjacent"/>
  <disable_collisions link1="ld06_body" link2="lidar_collision_proxy" reason="Adjacent"/>
  <disable_collisions link1="ld06_body" link2="laser_nominal" reason="Adjacent"/>
  <disable_collisions link1="laser_nominal" link2="laser" reason="Adjacent"/>
  <!-- Mesh-enclosing proxies are only disabled against bolted neighbours.
       Every non-adjacent pair remains collision-checked by MoveIt. -->
  <disable_collisions link1="base_link" link2="arm_pedestal_collision_proxy" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_camera_collision_proxy" reason="Adjacent"/>
  <!-- These oversized envelopes are on the same rigid chassis assembly;
       their relative placement cannot change with any arm joint. -->
  <disable_collisions link1="arm_pedestal_collision_proxy" link2="front_camera_collision_proxy" reason="Never"/>
  <disable_collisions link1="arm_pedestal_collision_proxy" link2="lidar_collision_proxy" reason="Never"/>
  <disable_collisions link1="arm_pedestal_collision_proxy" link2="shoulder_collision_proxy" reason="Adjacent"/>
  <disable_collisions link1="shoulder_collision_proxy" link2="upper_arm_collision_proxy" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_collision_proxy" link2="forearm_collision_proxy" reason="Adjacent"/>
  <disable_collisions link1="forearm_collision_proxy" link2="wrist_collision_proxy" reason="Adjacent"/>
  <disable_collisions link1="wrist_collision_proxy" link2="roll_collision_proxy" reason="Adjacent"/>
  <disable_collisions link1="roll_collision_proxy" link2="gripper_collision_proxy" reason="Adjacent"/>
</robot>
