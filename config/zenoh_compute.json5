// Compute-side half of the sensor bridge; see zenoh_device.json5. The launch
// file adds the device's endpoint (-e tls/<remote_ip>:7447). The link is
// mutual TLS; see zenoh_device.json5.
{
  plugins: {
    ros2dds: {
      allow: {
        publishers: [],
        subscribers: [
          "^/pi/lidar/scan$",
          "^/pi/camera/(front|wrist)/(image_raw/compressed|camera_info)$",
          "^/camera/depth/points$",
          "^/camera/astra/color/image_raw/compressed$",
          "^/camera/astra/color/camera_info$",
        ],
        service_servers: [],
        service_clients: [],
        action_servers: [],
        action_clients: [],
      },
    },
  },
  // A client never listens and keeps reconnecting to the device on its own.
  mode: "client",
  transport: {
    link: {
      tls: {
        root_ca_certificate: "/etc/lekiwi/zenoh-tls/ca.crt",
        connect_private_key: "/etc/lekiwi/zenoh-tls/compute.key",
        connect_certificate: "/etc/lekiwi/zenoh-tls/compute.crt",
        enable_mtls: true,
        // The device is reached by whatever address is current (LAN, Tailscale);
        // its identity is the private CA's signature, not its name.
        verify_name_on_connect: false,
      },
    },
  },
  scouting: { multicast: { enabled: false }, gossip: { enabled: false } },
}
