# Robot computer running the LeKiwi motor, camera, and lidar services.
LEKIWI_ROBOT_HOST=robot-1
# Set on both the robot computer and the workstation. false (default): a failure
# stops the base and freezes the arm but never cuts servo torque. true: every
# failure cuts all servo torque and a failed cut latches TORQUE_FAULT.
# LEKIWI_DISABLE_TORQUE_ON_FAILURE=false
