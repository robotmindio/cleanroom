# Robot computer running the LeKiwi motor, camera, and lidar services.
LEKIWI_ROBOT_HOST=robot-1
# Set on both the robot computer and the workstation. false (default): the robot
# stays armed; a failure stops the base, freezes the arm with torque on, and the
# driver re-arms itself. true (larger robots): every failure disarms, cuts all servo
# torque, latches TORQUE_FAULT if the cut is unconfirmed, and waits for /safety/arm.
# LEKIWI_DISARM_ON_FAILURE=false
