# Robot computer running the LeKiwi motor, camera, and lidar services.
LEKIWI_ROBOT_HOST=robot-1
# Set on both the robot computer and the workstation. false (default): the robot
# stays armed; a failure stops the base, freezes the arm with torque on, and the
# driver re-arms itself. true (larger robots): every failure disarms, cuts all servo
# torque, latches TORQUE_FAULT if the cut is unconfirmed, and waits for /safety/arm.
# LEKIWI_DISARM_ON_FAILURE=false
# Wi-Fi regulatory country (ISO 3166, two uppercase letters) applied by
# scripts/install.sh and scripts/install-device-services.sh; default ID (Indonesia).
# LEKIWI_WIFI_COUNTRY=ID
# Per-machine hardware, read on the machine the device is plugged into (also under
# systemd). The defaults find the standard adapters and cameras by their USB names.
# Motor-bus adapter, LeRobot calibration identity, LD06 adapter, front camera and
# wrist camera (a /dev path, or none to run without it):
# LEKIWI_PORT=/dev/serial/by-id/usb-EXAMPLE-if00
# LEKIWI_ID=lekiwi_1
# LEKIWI_LIDAR_PORT=/dev/serial/by-id/usb-EXAMPLE-if00-port0
# LEKIWI_FRONT=/dev/v4l/by-id/usb-EXAMPLE-video-index0
# LEKIWI_WRIST=none
